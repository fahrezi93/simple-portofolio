---
import { ContactForm } from './ContactForm';
import { profile } from "../../data/profile";
---

<div class="screen-line-top screen-line-bottom overflow-y-clip border-x border-y border-line">
  <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-line">
    <div class="p-6 sm:p-8">
      <h2 class="font-handwriting text-3xl sm:text-4xl font-bold tracking-wide text-foreground mb-2 leading-none">Get in touch</h2>
      <p class="text-muted-foreground mb-8">
        Currently seeking new challenges. Whether you have a specific project or just want to say hi, I'm all ears.
      </p>
      
      <div class="space-y-4">
        <div>
          <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase mb-1">Based In</p>
          <p class="text-foreground">{profile.location}</p>
        </div>
        <div>
          <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase mb-1">Email</p>
          <a href={`mailto:${profile.email}`} class="text-foreground hover:underline transition-colors">{profile.email}</a>
        </div>
      </div>
    </div>

    <div class="p-6 sm:p-8 max-md:screen-line-top">
      <ContactForm client:visible />
    </div>
  </div>
</div>
