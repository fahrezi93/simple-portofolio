---
interface Props {
  class?: string;
  className?: string;
}

const { class: className = "size-5 sm:size-6 shrink-0", className: altClass } = Astro.props;
const finalClass = altClass || className;
---

<svg
  viewBox="0 0 16 16"
  class={finalClass}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Meta Verified"
>
  <title>Verified</title>
  <defs>
    <linearGradient id="meta-verified-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0064E0" />
      <stop offset="100%" stop-color="#0095F6" />
    </linearGradient>
  </defs>
  <!-- Scalloped Rosette Badge -->
  <path
    d="M10.067.87a2.89 2.89 0 0 0-4.134 0l-.622.638-.89-.011a2.89 2.89 0 0 0-2.924 2.924l.01.89-.636.622a2.89 2.89 0 0 0 0 4.134l.637.622-.011.89a2.89 2.89 0 0 0 2.924 2.924l.89-.01.622.636a2.89 2.89 0 0 0 4.134 0l.622-.637.89.011a2.89 2.89 0 0 0 2.924-2.924l-.01-.89.636-.622a2.89 2.89 0 0 0 0-4.134l-.637-.622.011-.89a2.89 2.89 0 0 0-2.924-2.924l-.89.01z"
    fill="url(#meta-verified-gradient)"
  />
  <!-- Inner Pure White Checkmark -->
  <path
    d="m10.354 6.854-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708.708z"
    fill="#FFFFFF"
  />
</svg>
