---
import Layout from "../layouts/Layout.astro";
import { Navigation } from "../components/shared/Navigation";
import Footer from "../components/shared/Footer.astro";
import { Button } from "../components/ui/button";
import { Home } from "lucide-react";
import { FluidGradientText } from "../components/ui/fluid-gradient-text";
---

<Layout title="404: Not Found | Fahrezi">
  <Navigation client:load />

  <main
    class="w-full min-h-screen flex flex-col items-center justify-center pt-20 pb-10 px-4"
  >
    <div
      class="relative flex flex-col items-center justify-center text-center p-10 w-full max-w-lg"
    >
      {/* Decorative Background Elements */}
      <div
        class="absolute inset-0 bg-muted/20 border border-line rounded-3xl -z-10"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-background/50 to-transparent rounded-3xl -z-10"
      >
      </div>

      {/* Big 404 Text */}
      <div class="mb-4">
        <FluidGradientText
          client:load
          text="404"
          svgViewBoxWidth={400}
          svgViewBoxHeight={150}
        />
      </div>

      <h1 class="text-3xl font-semibold tracking-tight mb-3">Page Not Found</h1>
      <p class="text-muted-foreground text-sm mb-8 max-w-sm mx-auto">
        The page you are looking for doesn't exist, has been moved, or is
        temporarily unavailable.
      </p>

      <a href="/">
        <Button
          variant="outline"
          className="gap-2 h-11 px-6 rounded-xl hover:bg-foreground hover:text-background transition-colors"
        >
          <Home className="size-4" />
          <span class="font-medium">Return Home</span>
        </Button>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
