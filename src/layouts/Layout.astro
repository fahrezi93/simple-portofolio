---
import '../styles/global.css';

import { Preloader } from '../components/ui/Preloader';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title,
	description = "Mohammad Fahrezi - Developer & Designer Portfolio. Crafting immersive digital experiences.",
	image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dev.fahrezi.tech');
const imageURL = new URL(image, 'https://dev.fahrezi.tech');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/fahrezi_white_logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- SEO Basics -->
		<link rel="canonical" href={canonicalURL} />
		<meta name="author" content="Mohammad Fahrezi" />
		<meta name="robots" content="index, follow" />
		<meta name="keywords" content="Mohammad Fahrezi, fahrezi93, Frontend Developer, Graphic Designer, Web Developer, UI/UX Designer, React, Astro, Next.js, TailwindCSS, Indonesia" />
		
		<!-- OpenGraph Meta Tags -->
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mohammad Fahrezi Portfolio" />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:creator" content="@fahrrrezi" />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background overflow-x-hidden">
		<Preloader client:load />
		<div class="mx-auto md:max-w-3xl border-x border-line min-h-screen relative dark:shadow-none bg-background">
			<slot />
		</div>
	</body>
</html>
