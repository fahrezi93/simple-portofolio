---
import '../styles/global.css';

import { Preloader } from '../components/ui/Preloader';
import { PixelBlast } from '../components/ui/PixelBlast';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title,
	description = "Mohammad Fahrezi - Developer & Designer Portfolio. Crafting immersive digital experiences.",
	image = "/og-image-v2.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dev.fahrezi.tech');
const imageURL = new URL(image, 'https://dev.fahrezi.tech');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/fahrezi_white_logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts for handwriting script (Non-render-blocking) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" />
		</noscript>
		
		<!-- SEO Basics -->
		<link rel="canonical" href={canonicalURL} />
		<meta name="author" content="Mohammad Fahrezi" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="keywords" content="Mohammad Fahrezi, fahrezi93, Frontend Developer Indonesia, Web Developer Palembang, Fresh Graduate UNSRI, Fresh Graduate Universitas Sriwijaya, Ilmu Komputer Unsri, Computer Science Graduate, Graphic Designer Indonesia, UI UX Designer, React Developer, Astro, Next.js, Tailwind CSS, TypeScript, Portfolio Developer" />
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark light" />
		
		<!-- AI & Machine Discovery Links -->
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM context" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		
		<!-- OpenGraph Meta Tags -->
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mohammad Fahrezi Portfolio" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="id_ID" />
		
		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content="Mohammad Fahrezi - Developer & Designer" />
		<meta name="twitter:creator" content="@fahrrrezi" />
		<meta name="twitter:site" content="@fahrrrezi" />

		<!-- Structured Data (JSON-LD) for Google & AI Search Engines -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "ProfilePage",
						"@id": "https://dev.fahrezi.tech/#profilepage",
						"url": "https://dev.fahrezi.tech",
						"name": "Mohammad Fahrezi - Developer & Designer Portfolio",
						"description": "Mohammad Fahrezi - Computer Science Fresh Graduate from Sriwijaya University (UNSRI), Frontend Developer & Designer Portfolio.",
						"mainEntity": {
							"@id": "https://dev.fahrezi.tech/#person"
						}
					},
					{
						"@type": "Person",
						"@id": "https://dev.fahrezi.tech/#person",
						"name": "Mohammad Fahrezi",
						"alternateName": ["Fahrezi", "fahrezi93", "Moh. Fahrezi"],
						"url": "https://dev.fahrezi.tech",
						"image": "https://dev.fahrezi.tech/profile.webp",
						"jobTitle": [
							"Frontend Developer",
							"Web Developer",
							"Graphic Designer",
							"UI/UX Designer"
						],
						"email": "mailto:hello@fahrezi.tech",
						"alumniOf": {
							"@type": "CollegeOrUniversity",
							"name": "Universitas Sriwijaya",
							"alternateName": "UNSRI",
							"sameAs": "https://unsri.ac.id"
						},
						"knowsAbout": [
							"Frontend Development",
							"Web Development",
							"React",
							"Next.js",
							"Astro",
							"TypeScript",
							"JavaScript",
							"Tailwind CSS",
							"Python",
							"Flask",
							"Machine Learning",
							"Cloud Computing",
							"UI/UX Design",
							"Graphic Design",
							"Figma",
							"Adobe Photoshop"
						],
						"sameAs": [
							"https://github.com/fahrezi93",
							"https://linkedin.com/in/mohammad-fahrezi",
							"https://instagram.com/moh.fahrezi",
							"https://twitter.com/fahrrrezi"
						],
						"address": {
							"@type": "PostalAddress",
							"addressCountry": "Indonesia"
						},
						"description": "Mohammad Fahrezi is a Computer Science graduate from Sriwijaya University focused on full-stack web development and UI/UX design."
					},
					{
						"@type": "WebSite",
						"@id": "https://dev.fahrezi.tech/#website",
						"url": "https://dev.fahrezi.tech",
						"name": "Mohammad Fahrezi Portfolio",
						"description": "Portfolio of Mohammad Fahrezi, Developer & Designer.",
						"publisher": {
							"@id": "https://dev.fahrezi.tech/#person"
						},
						"inLanguage": ["en", "id"]
					}
				]
			}
		</script>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background overflow-x-hidden relative">
		<!-- Ambient PixelBlast dots on left & right margins (flanks) like zickrian.dev (disabled on mobile) -->
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 hidden sm:block overflow-hidden select-none">
			<PixelBlast client:media="(min-width: 640px)" className="w-full h-full" pixelSize={7} patternScale={2.0} patternDensity={0.78} speed={0.35} opacity={0.52} />
		</div>

		<Preloader client:load />
		<div class="mx-auto md:max-w-3xl border-x border-line min-h-screen relative dark:shadow-none bg-background">
			<slot />
		</div>
	</body>
</html>
