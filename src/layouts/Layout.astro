---
import '../styles/global.css';

import { Preloader } from '../components/ui/Preloader';
import { PixelBlast } from '../components/ui/PixelBlast';

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const { 
	title,
	description = "Mohammad Fahrezi, software engineer in Indonesia. Explore frontend and full-stack projects using React, Next.js, Laravel, and PHP, plus work experience.",
	image = "/og-image-v2.png",
	noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const structuredData = {
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "ProfilePage",
						"@id": new URL("/#profilepage", Astro.site).href,
						"url": new URL("/", Astro.site).href,
						"name": title,
						"description": description,
						"mainEntity": {
							"@id": new URL("/#person", Astro.site).href
						}
					},
					{
						"@type": "Person",
						"@id": new URL("/#person", Astro.site).href,
						"name": "Mohammad Fahrezi",
						"alternateName": ["Fahrezi", "fahrezi93", "Moh. Fahrezi"],
						"url": new URL("/", Astro.site).href,
						"image": new URL("/profile.webp", Astro.site).href,
						"jobTitle": [
							"Software Engineer",
							"Frontend Developer",
							"Web Developer",
							"Graphic Designer"
						],
						"email": "mailto:hello@mohfahrezi.dev",
						"alumniOf": {
							"@type": "CollegeOrUniversity",
							"name": "Universitas Sriwijaya",
							"alternateName": "UNSRI",
							"sameAs": "https://unsri.ac.id"
						},
						"knowsAbout": [
							"Frontend Development",
							"Web Development",
							"Full-Stack Development",
							"Laravel",
							"PHP",
							"SQL Server",
							"React",
							"Next.js",
							"Astro",
							"TypeScript",
							"JavaScript",
							"Tailwind CSS",
							"Python",
							"Flask",
							"Machine Learning",
							"Cloud Computing",
							"Graphic Design",
							"Figma",
							"Adobe Photoshop"
						],
						"sameAs": [
							"https://github.com/fahrezi93",
							"https://linkedin.com/in/mohammad-fahrezi",
							"https://instagram.com/moh.fahrezi",
							"https://g.dev/fahrezi"
						],
						"address": {
							"@type": "PostalAddress",
							"addressCountry": "Indonesia"
						},
						"description": "Mohammad Fahrezi is a Computer Science graduate from Sriwijaya University focused on frontend and full-stack web development."
					},
					{
						"@type": "WebSite",
						"@id": new URL("/#website", Astro.site).href,
						"url": new URL("/", Astro.site).href,
						"name": "Mohammad Fahrezi Portfolio",
						"description": "Portfolio of Mohammad Fahrezi, Developer & Designer.",
						"publisher": {
							"@id": new URL("/#person", Astro.site).href
						},
						"inLanguage": "en"
					}
				]
			};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts for handwriting script (Non-render-blocking) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap" />
		</noscript>
		
		<!-- SEO Basics -->
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		<meta name="author" content="Mohammad Fahrezi" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<meta name="google-site-verification" content="a1dehL3LV-Ox-tvawWYDzDrnv0ranCSr8QUDKLPw41k" />
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark light" />
		
		<!-- AI & Machine Discovery Links -->
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM context" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		
		<!-- OpenGraph Meta Tags -->
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:alt" content="Mohammad Fahrezi - Developer & Designer" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mohammad Fahrezi Portfolio" />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content="Mohammad Fahrezi - Developer & Designer" />

		<!-- Structured Data (JSON-LD) for Google & AI Search Engines -->
		{!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\u003c")} />}
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background overflow-x-hidden relative">
		<!-- Ambient PixelBlast dots on left & right margins (flanks) like zickrian.dev (disabled on mobile) -->
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 hidden sm:block overflow-hidden select-none">
			<PixelBlast client:media="(min-width: 640px)" className="w-full h-full" pixelSize={7} patternScale={2.0} patternDensity={0.78} speed={0.35} opacity={0.52} />
		</div>

		<Preloader client:load />
		<div class="mx-auto md:max-w-3xl border-x border-line min-h-screen relative dark:shadow-none bg-background">
			<slot />
		</div>
	</body>
</html>
