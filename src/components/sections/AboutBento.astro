---
import { profile } from "../../data/profile";
---

<div class="screen-line-top screen-line-bottom overflow-y-clip border-x border-y border-line">
  <div class="p-6 sm:p-8">
    <h2 class="font-handwriting text-3xl sm:text-4xl font-bold tracking-wide text-foreground mb-6 leading-none">Hello</h2>
    
    <ul class="space-y-4 text-muted-foreground leading-relaxed list-none">
      <li class="relative step pl-10 before:absolute before:left-0 before:top-0.5 before:flex before:size-6 before:items-center before:justify-center before:rounded-lg before:bg-muted before:text-[0.8125rem] before:font-medium before:text-foreground before:content-[counter(step)]" style="counter-increment: step;">
        I'm {profile.name} — a {profile.role} based in {profile.location}. I focus on building responsive web applications and designing clean, intuitive user interfaces.
      </li>
      <li class="relative step pl-10 before:absolute before:left-0 before:top-0.5 before:flex before:size-6 before:items-center before:justify-center before:rounded-lg before:bg-muted before:text-[0.8125rem] before:font-medium before:text-foreground before:content-[counter(step)]" style="counter-increment: step;">
        {profile.bio}
      </li>
    </ul>
  </div>
</div>
