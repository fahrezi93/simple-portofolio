---
import { projects } from "../../data/portfolio";
---

<section id="projects" class="space-y-8 scroll-mt-24">
  <div class="space-y-2">
    <h2 class="text-3xl font-bold tracking-tight">Featured Projects</h2>
    <p class="text-muted-foreground">A selection of my recent work in web and mobile development.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <div class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-border bg-card p-6 shadow-sm transition-all hover:shadow-md hover:border-primary/50">
        <div class="space-y-4">
          <div class="flex items-start justify-between">
            <h3 class="font-semibold text-xl tracking-tight">{project.title}</h3>
            {project.status === "Completed" ? (
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-emerald-600 border-emerald-200 bg-emerald-50 dark:bg-emerald-950 dark:border-emerald-800 dark:text-emerald-400">
                Completed
              </span>
            ) : project.status === "In Progress" ? (
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-amber-600 border-amber-200 bg-amber-50 dark:bg-amber-950 dark:border-amber-800 dark:text-amber-400">
                In Progress
              </span>
            ) : (
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">
                {project.status}
              </span>
            )}
          </div>
          
          <p class="text-sm text-muted-foreground leading-relaxed">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {project.tags.slice(0, 4).map(tag => (
              <span class="inline-flex items-center rounded-md bg-secondary px-2 py-1 text-xs font-medium text-secondary-foreground">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-6 flex items-center gap-4 pt-4 border-t border-border/50">
          {project.liveUrl && project.liveUrl !== "#" && (
            <a href={project.liveUrl} target="_blank" rel="noreferrer" class="text-sm font-medium hover:text-primary transition-colors inline-flex items-center gap-1">
              Live Demo
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9C12 9.27614 11.7761 9.5 11.5 9.5C11.2239 9.5 11 9.27614 11 9L11 4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </a>
          )}
          {project.githubUrl && project.githubUrl !== "#" && (
            <a href={project.githubUrl} target="_blank" rel="noreferrer" class="text-sm font-medium hover:text-primary transition-colors inline-flex items-center gap-1">
              Source
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3"><path d="M7.49933 0.25C3.49635 0.25 0.25 3.49593 0.25 7.50024C0.25 10.703 2.32715 13.4206 5.2081 14.3797C5.57084 14.446 5.70302 14.2222 5.70302 14.0299C5.70302 13.8576 5.69679 13.4019 5.69323 12.797C3.67661 13.235 3.25112 11.825 3.25112 11.825C2.92132 10.9874 2.44599 10.7644 2.44599 10.7644C1.78773 10.3149 2.49584 10.3238 2.49584 10.3238C3.22353 10.375 3.60629 11.0711 3.60629 11.0711C4.25298 12.1788 5.30335 11.8588 5.71638 11.6732C5.78258 11.205 5.96962 10.8854 6.17658 10.7043C4.56675 10.5209 2.87415 9.89918 2.87415 7.12159C2.87415 6.33115 3.15677 5.68255 3.62053 5.17563C3.54576 4.99226 3.29697 4.25591 3.69178 3.25615C3.69178 3.25615 4.30015 3.06198 5.68522 3.99971C6.26337 3.83906 6.8838 3.75895 7.50022 3.75583C8.1162 3.75895 8.73619 3.83906 9.31523 3.99971C10.6994 3.06198 11.3069 3.25615 11.3069 3.25615C11.7026 4.25591 11.4538 4.99226 11.3795 5.17563C11.8441 5.68255 12.1259 6.33115 12.1259 7.12159C12.1259 9.90609 10.4295 10.5187 8.81423 10.6983C9.07346 10.9221 9.30633 11.3648 9.30633 12.0413C9.30633 13.0102 9.29742 13.7922 9.29742 14.0299C9.29742 14.2239 9.42828 14.4496 9.79591 14.3788C12.6746 13.4179 14.75 10.7025 14.75 7.50024C14.75 3.49593 11.5036 0.25 7.49933 0.25Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
