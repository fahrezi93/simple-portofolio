---
import { profile } from "../../data/profile";
import {
  MapPin,
  Mail,
  Clock,
  Code2,
  GraduationCap,
  Briefcase,
  FileText,
} from "lucide-react";
import {
  FaGithub,
  FaLinkedin,
  FaTwitter,
  FaInstagram,
  FaDiscord,
  FaWhatsapp,
} from "react-icons/fa";
import { HeroRoleText } from "../ui/HeroRoleText";
import { LocalTime } from "../ui/LocalTime";
import WorldMap from "./WorldMap.astro";
import { AsciiBanner } from "../ui/AsciiBanner";
import MetaVerifiedBadge from "../ui/MetaVerifiedBadge.astro";
---

<div
  class="screen-line-top screen-line-bottom border-x border-y border-line mt-14"
>
  <AsciiBanner client:load src="/banner.webp" alt="Mohammad Fahrezi Banner" />
</div>

<div
  class="screen-line-top screen-line-bottom border-x border-y border-line -mt-px bg-background"
>
  {/* Profile Header: Overlapping Avatar, Name, Role, and Status Badge */}
  <div class="px-5 pt-0 pb-5 sm:px-6 sm:pb-6 relative z-20">
    {/* Avatar overlapping banner bottom */}
    <div
      class="relative -mt-12 sm:-mt-16 size-24 sm:size-32 shrink-0 aspect-square rounded-full overflow-hidden border-4 border-background bg-card shadow-xl ring-1 ring-line group z-20"
    >
      <img
        src="/profile.webp"
        alt="Mohammad Fahrezi"
        class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500"
      />
    </div>

    {/* Identity: Name & Dynamic Role */}
    <div class="mt-4 space-y-1">
      <div class="flex items-center gap-2">
        <h1
          class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground"
        >
          {profile.name}
        </h1>
        <MetaVerifiedBadge
          class="size-5 sm:size-[22px] shrink-0 inline-block drop-shadow-xs"
        />
      </div>
      <div
        class="flex items-center gap-1.5 text-sm sm:text-base text-muted-foreground font-medium"
      >
        <span class="shrink-0 text-muted-foreground">I am a</span>
        <HeroRoleText client:load />
      </div>
    </div>
  </div>

  {/* Info Grid Cell (Full Width) */}
  <div class="flex flex-col border-t border-line screen-line-top">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-line border-b border-line screen-line-bottom"
    >
      {/* Left Info */}
      <div class="p-4 sm:p-5 space-y-3 text-sm text-muted-foreground">
        <div class="flex items-center gap-3">
          <Code2 className="size-4 shrink-0" />
          <span>{profile.role}</span>
        </div>
        <div class="flex items-center gap-3">
          <MapPin className="size-4 shrink-0" />
          <span>{profile.location}</span>
        </div>
        <div class="flex items-center gap-3">
          <Mail className="size-4 shrink-0" />
          <a
            href={`mailto:${profile.email}`}
            class="hover:text-foreground hover:underline transition-colors"
            >{profile.email}</a
          >
        </div>
      </div>

      {/* Right Info */}
      <div class="p-4 sm:p-5 space-y-3 text-sm text-muted-foreground">
        <div class="flex items-center gap-3">
          <GraduationCap className="size-4 shrink-0" />
          <span>Universitas Sriwijaya</span>
        </div>
        <div class="flex items-center gap-3">
          <Clock className="size-4 shrink-0" />
          <LocalTime client:load />
        </div>
        <div class="flex items-center gap-3">
          <Briefcase className="size-4 shrink-0" />
          <span>Available for Work & Internship</span>
        </div>
      </div>
    </div>

    {/* Social Links Bar */}
    <div
      class="flex items-center justify-between p-4 sm:px-5 text-muted-foreground flex-wrap gap-3"
    >
      <div class="flex items-center gap-2">
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
        >
          <FaGithub className="size-5" />
          <span class="sr-only">GitHub</span>
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
        >
          <FaLinkedin className="size-5" />
          <span class="sr-only">LinkedIn</span>
        </a>
        <a
          href={profile.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
        >
          <FaInstagram className="size-5" />
          <span class="sr-only">Instagram</span>
        </a>
        {
          profile.twitter && (
            <a
              href={profile.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
            >
              <FaTwitter className="size-5" />
              <span class="sr-only">Twitter/X</span>
            </a>
          )
        }
        {
          profile.discord && (
            <a
              href={profile.discord}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
            >
              <FaDiscord className="size-5" />
              <span class="sr-only">Discord</span>
            </a>
          )
        }
        {
          profile.whatsapp && (
            <a
              href={profile.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground transition-colors p-2 rounded-md hover:bg-muted"
            >
              <FaWhatsapp className="size-5" />
              <span class="sr-only">WhatsApp</span>
            </a>
          )
        }
      </div>

      {
        profile.resume && (
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-line bg-muted/40 hover:bg-muted text-foreground text-xs font-medium transition-colors"
          >
            <FileText className="size-3.5" />
            <span>Resume</span>
          </a>
        )
      }
    </div>
  </div>
</div>
