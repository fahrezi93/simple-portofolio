---
import DottedMap from "dotted-map";

const map = new DottedMap({ height: 100, grid: "diagonal" });

const svgMap = map.getSVG({
  radius: 0.15,
  color: "currentColor",
  shape: "circle",
  backgroundColor: "transparent",
});
---

<div
  class="relative w-full h-32 sm:h-48 md:h-56 overflow-hidden flex items-center justify-center"
>
  <div
    class="absolute inset-0 bg-gradient-to-t from-background to-transparent z-10"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-background/50 to-transparent z-10"
  >
  </div>
  <div
    class="w-full opacity-100 map-container flex justify-center text-foreground/100 dark:text-foreground/100"
    set:html={svgMap}
  />
</div>

<style is:global>
  .map-container svg {
    width: 100%;
    height: auto;
    max-width: 1000px;
  }
  .map-container circle[fill="#39d353"] {
    animation: pulse-pin 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes pulse-pin {
    0% {
      opacity: 1;
      r: 0.4;
    }
    50% {
      opacity: 0.4;
      r: 1.2;
    }
    100% {
      opacity: 1;
      r: 0.4;
    }
  }
</style>
